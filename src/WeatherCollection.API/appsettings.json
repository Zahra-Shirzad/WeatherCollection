{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=WeatherCollectionDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "WeatherWorker": {
    "MaxConcurrency": 5,
    "BatchSize": 10,
    "PollingIntervalSeconds": 5,
    "MaxAttempts": 5,
    "LeaseDurationSeconds": 60,
    "DependencyBackoffSeconds": 30
  }
}